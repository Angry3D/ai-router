{
  "name": "ai-router",
  "private": true,
  "version": "0.1.0",
  "description": "A local macOS routing tool for Codex CLI and Codex App.",
  "author": "Angry3D",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Angry3D/ai-router"
  },
  "homepage": "https://github.com/Angry3D/ai-router",
  "bugs": {
    "url": "https://github.com/Angry3D/ai-router/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "10.33.2"
  },
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "dev:qa": "vite --mode qa --port 1421 --strictPort",
    "build": "pnpm version:check && tsc -b && vite build",
    "build:qa": "pnpm version:check && tsc -b && vite build --mode qa",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "ci:policy": "node scripts/check-ci-policy.mjs",
    "contracts:check": "node scripts/generate-types.mjs --check && vitest run src/features/settings/baseUrlPreview.test.ts && cargo test -p router-core base_url_matches_the_shared_cross_layer_contract",
    "docs:check": "node scripts/check-public-docs.mjs",
    "license:check": "node scripts/check-licenses.mjs",
    "license:public:check": "node scripts/check-licenses.mjs --scan-public-tree .",
    "security:check": "node scripts/check-repository-security.mjs",
    "security:public:check": "node scripts/check-repository-security.mjs --public-tree",
    "check:codex-retries": "node scripts/check-codex-retry-contract.mjs",
    "qa:v0-2a:fixture": "node scripts/v0-2a-qa-fixture.mjs",
    "qa:v0-2a:identity": "node scripts/v0-2a-qa-identity.mjs",
    "qa:v0-2a:evidence": "node scripts/v0-2a-qa-evidence.mjs",
    "qa:v0-2a:lifecycle": "node scripts/v0-2a-qa-identity.mjs",
    "qa:v0-2a:request": "cargo run -p router-core --example v0_2a_qa_fixture -- request",
    "qa:v0-2a:inspect": "cargo run -p router-core --example v0_2a_qa_fixture -- inspect",
    "qa:v0-2a:seed": "cargo run -p router-core --example v0_2a_qa_fixture -- seed",
    "qa:usage:seed": "cargo run -p router-core --example v0_2a_qa_fixture -- usage-seed",
    "qa:v0-2a:cleanup": "node scripts/v0-2a-qa-identity.mjs cleanup",
    "qa:v0-2b:recovery": "node scripts/v0-2b-qa-recovery.mjs",
    "qa:v0-2b:root": "node scripts/v0-2b-qa-recovery.mjs root",
    "qa:v0-2b:baseline": "node scripts/v0-2b-qa-recovery.mjs baseline",
    "qa:v0-2b:seed": "node scripts/v0-2b-qa-recovery.mjs seed",
    "qa:v0-2b:inspect": "node scripts/v0-2b-qa-recovery.mjs inspect",
    "qa:v0-2b:apply": "node scripts/v0-2b-qa-recovery.mjs apply",
    "generate:types": "node scripts/generate-types.mjs",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "version:check": "node scripts/manage-version.mjs check",
    "version:sync": "node scripts/manage-version.mjs sync",
    "tauri": "tauri",
    "tauri:qa:dev": "tauri dev --config src-tauri/tauri.qa.conf.json",
    "tauri:prod:build": "node scripts/manage-build-artifacts.mjs build production",
    "tauri:qa:build": "node scripts/manage-build-artifacts.mjs build qa",
    "tauri:source:build": "node scripts/manage-build-artifacts.mjs build source",
    "artifacts:clean": "node scripts/manage-build-artifacts.mjs clean"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@tanstack/react-query": "^5.90.0",
    "@tauri-apps/api": "^2.8.0",
    "echarts": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@openai/codex": "0.146.0",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "3.9.5",
    "semver": "7.8.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0",
    "yaml": "2.9.0"
  }
}
