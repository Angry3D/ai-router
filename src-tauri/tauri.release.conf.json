{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["dmg"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Angry3D/ai-router/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "__AI_ROUTER_UPDATER_PUBLIC_KEY__"
    }
  }
}
