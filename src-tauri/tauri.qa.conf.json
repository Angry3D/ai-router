{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Router QA",
  "identifier": "com.relax.airouter.qa",
  "build": {
    "beforeDevCommand": "pnpm dev:qa",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build:qa"
  },
  "bundle": {
    "icon": ["icons/app-icon-qa.icns"],
    "targets": ["app"]
  },
  "app": {
    "windows": [
      {
        "label": "menu",
        "title": "AI Router QA",
        "url": "menu.html",
        "width": 384,
        "height": 420,
        "minHeight": 274,
        "maxHeight": 674,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "AI Router QA Settings",
        "url": "settings.html",
        "width": 920,
        "height": 640,
        "minWidth": 760,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "active": false,
      "dangerousInsecureTransportProtocol": true
    }
  }
}
